# 依赖与包管理器缓存；依赖锁文件应提交。
node_modules/
.pnpm-store/
.npm/

# 构建、打包、测试与工具缓存。
out/
dist/
release/
coverage/
playwright-report/
test-results/
.cache/
.vite/
*.tsbuildinfo

# 本地配置与诊断；可提交不含秘密的配置示例。
/.workbuddy/
.env
.env.*
!.env.example
*.local
*.log
logs/

# 运行数据库、伴随文件与个人数据不进入版本控制。
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
/local-data/
/backups/
/question-banks/personal/
/tmp/
/temp/

# 故障现场中的浏览器运行缓存保留本机；报告、截图和测试来源仍跟踪。
/docs/evidence/**/failed-workspaces/**/session/

# 操作系统文件。
.DS_Store
Thumbs.db
Desktop.ini
