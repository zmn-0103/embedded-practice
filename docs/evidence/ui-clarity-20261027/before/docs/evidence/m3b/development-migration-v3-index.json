  "schema": [
    {
      "type": "table",
      "name": "app_startup",
      "tbl_name": "app_startup",
      "rootpage": 2,
      "sql": "CREATE TABLE app_startup (id INTEGER PRIMARY KEY, launch_count INTEGER NOT NULL,\n        last_started_at TEXT NOT NULL) STRICT"
    },
    {
      "type": "index",
      "name": "custom_mode",
      "tbl_name": "practice_sessions",
      "rootpage": 30,
      "sql": "CREATE INDEX custom_mode ON practice_sessions(mode)"
    },
    {
      "type": "table",
      "name": "image_resources",
      "tbl_name": "image_resources",
      "rootpage": 11,
      "sql": "CREATE TABLE image_resources (\n    hash TEXT PRIMARY KEY CHECK (length(hash) = 64),\n    format TEXT NOT NULL CHECK (format IN ('png', 'jpeg', 'webp')),\n    width INTEGER NOT NULL CHECK (width > 0),\n    height INTEGER NOT NULL CHECK (height > 0),\n    bytes BLOB NOT NULL CHECK (length(bytes) BETWEEN 1 AND 10485760)\n  ) STRICT"
    },
    {
      "type": "table",
      "name": "import_receipts",
      "tbl_name": "import_receipts",
      "rootpage": 16,
      "sql": "CREATE TABLE import_receipts (\n    token TEXT PRIMARY KEY,\n    committed_at TEXT NOT NULL,\n    result_json TEXT NOT NULL CHECK (json_valid(result_json))\n  ) STRICT"
    },
    {
      "type": "table",
      "name": "library_meta",
      "tbl_name": "library_meta",
      "rootpage": 3,
      "sql": "CREATE TABLE library_meta (\n    id INTEGER PRIMARY KEY CHECK (id = 1),\n    revision INTEGER NOT NULL CHECK (revision BETWEEN 0 AND 9007199254740991)\n  ) STRICT"
    },
    {
      "type": "table",
      "name": "practice_items",
      "tbl_name": "practice_items",
      "rootpage": 24,
      "sql": "CREATE TABLE practice_items (\n    session_id TEXT NOT NULL REFERENCES practice_sessions(id),\n    position INTEGER NOT NULL CHECK (position BETWEEN 0 AND 9007199254740991),\n    question_id INTEGER NOT NULL REFERENCES questions(id),\n    version_id INTEGER NOT NULL,\n    title TEXT NOT NULL,\n    topic_title TEXT NOT NULL,\n    tags_json TEXT NOT NULL CHECK (json_valid(tags_json)),\n    difficulty TEXT NOT NULL CHECK (difficulty IN ('未分级', '基础', '进阶', '综合')),\n    draft TEXT NOT NULL DEFAULT '' CHECK (length(CAST(draft AS BLOB)) <= 1048576),\n    draft_revision INTEGER NOT NULL DEFAULT 0 CHECK (draft_revision BETWEEN 0 AND 9007199254740991),\n    revealed_at TEXT,\n    rating TEXT CHECK (rating IN ('不会', '不熟', '掌握')),\n    rated_at TEXT,\n    skipped_at TEXT,\n    PRIMARY KEY (session_id, position),\n    UNIQUE (session_id, question_id),\n    FOREIGN KEY (version_id, question_id) REFERENCES question_versions(id, question_id),\n    CHECK ((rating IS NULL) = (rated_at IS NULL)),\n    CHECK (rating IS NULL OR revealed_at IS NOT NULL)\n  ) STRICT"
    },
    {
      "type": "index",
      "name": "practice_items_version",
      "tbl_name": "practice_items",
      "rootpage": 29,
      "sql": "CREATE INDEX practice_items_version ON practice_items(version_id)"
    },
    {
      "type": "index",
      "name": "practice_one_active",
      "tbl_name": "practice_sessions",
      "rootpage": 23,
      "sql": "CREATE UNIQUE INDEX practice_one_active ON practice_sessions(status) WHERE status = 'active'"
    },
    {
      "type": "table",
      "name": "practice_receipts",
      "tbl_name": "practice_receipts",
      "rootpage": 27,
      "sql": "CREATE TABLE practice_receipts (\n    request_id TEXT PRIMARY KEY,\n    payload_hash TEXT NOT NULL CHECK (length(payload_hash) = 64),\n    result_json TEXT NOT NULL CHECK (json_valid(result_json)),\n    created_at TEXT NOT NULL\n  ) STRICT"
    },
    {
      "type": "table",
      "name": "practice_sessions",
      "tbl_name": "practice_sessions",
      "rootpage": 19,
      "sql": "CREATE TABLE practice_sessions (\n    id TEXT PRIMARY KEY,\n    mode TEXT NOT NULL CHECK (mode = 'sequential'),\n    topic_id TEXT REFERENCES topics(topic_id),\n    status TEXT NOT NULL CHECK (status IN ('active', 'finished', 'ended')),\n    position INTEGER NOT NULL CHECK (position BETWEEN 0 AND 9007199254740991),\n    revision INTEGER NOT NULL CHECK (revision BETWEEN 0 AND 9007199254740991),\n    created_at TEXT NOT NULL,\n    ended_at TEXT,\n    CHECK ((status = 'active') = (ended_at IS NULL))\n  ) STRICT"
    },
    {
      "type": "table",
      "name": "question_user_state",
      "tbl_name": "question_user_state",
      "rootpage": 15,
      "sql": "CREATE TABLE question_user_state (\n    question_id INTEGER PRIMARY KEY REFERENCES questions(id),\n    favorite INTEGER NOT NULL DEFAULT 0 CHECK (favorite IN (0, 1)),\n    last_rating TEXT CHECK (last_rating IN ('不会', '不熟', '掌握')),\n    last_rated_version_id INTEGER,\n    CHECK ((last_rating IS NULL) = (last_rated_version_id IS NULL)),\n    FOREIGN KEY (last_rated_version_id, question_id) REFERENCES question_versions(id, question_id)\n  ) STRICT"
    },
    {
      "type": "table",
      "name": "question_versions",
      "tbl_name": "question_versions",
      "rootpage": 8,
      "sql": "CREATE TABLE question_versions (\n    id INTEGER PRIMARY KEY,\n    question_id INTEGER NOT NULL REFERENCES questions(id),\n    sequence INTEGER NOT NULL CHECK (sequence > 0),\n    title TEXT NOT NULL,\n    question_markdown TEXT NOT NULL,\n    answer_markdown TEXT NOT NULL,\n    definitions_json TEXT NOT NULL CHECK (json_valid(definitions_json)),\n    image_bindings_json TEXT NOT NULL CHECK (json_valid(image_bindings_json)),\n    content_hash TEXT NOT NULL CHECK (length(content_hash) = 64),\n    created_at TEXT NOT NULL,\n    UNIQUE (question_id, sequence),\n    UNIQUE (id, question_id)\n  ) STRICT"
    },
    {
      "type": "table",
      "name": "questions",
      "tbl_name": "questions",
      "rootpage": 6,
      "sql": "CREATE TABLE questions (\n    id INTEGER PRIMARY KEY,\n    topic_id TEXT NOT NULL REFERENCES topics(topic_id),\n    question_id TEXT NOT NULL,\n    title TEXT NOT NULL,\n    tags_json TEXT NOT NULL CHECK (json_valid(tags_json)),\n    difficulty TEXT NOT NULL CHECK (difficulty IN ('未分级', '基础', '进阶', '综合')),\n    position INTEGER NOT NULL CHECK (position >= 0),\n    archived INTEGER NOT NULL CHECK (archived IN (0, 1)),\n    current_version_id INTEGER,\n    UNIQUE (topic_id, question_id),\n    FOREIGN KEY (current_version_id, id) REFERENCES question_versions(id, question_id)\n  ) STRICT"
    },
    {
      "type": "index",
      "name": "questions_topic_order",
      "tbl_name": "questions",
      "rootpage": 18,
      "sql": "CREATE INDEX questions_topic_order ON questions(topic_id, archived, position)"
